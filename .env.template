# Mnemosyne OS 环境配置模板
# 复制为 .env 并填入你的密钥：cp .env.template .env
# 完整安装指南见 INSTALL.md

# ─────────────────────────────────────────
# 1. 模型后端
# ─────────────────────────────────────────

# ① Embedding — 固定走 OpenAI 兼容端点（OpenAI / 本地 vLLM / Ollama 等），必填
#    注册获取密钥: https://platform.openai.com
OPENAI_API_KEY=
# OPENAI_BASE_URL=https://api.openai.com/v1         # 本地: http://localhost:8000/v1
# OPENAI_EMBED_MODEL=text-embedding-3-small         # 默认 1536 维，需与 docs/schema.sql 的 vector(1536) 一致

#    Ollama 示例（本地或开发服务器，注意 base URL 要带 /v1，API key 可留空/任意值）:
# OPENAI_BASE_URL=http://localhost:11434/v1
# OPENAI_EMBED_MODEL=mxbai-embed-large              # 原生 1024 维（需先 `ollama pull mxbai-embed-large`）
# EMBED_DIM=1024                                    # 必须等于模型的原生输出维度

# ── 嵌入维度（必须与所选 embedding 模型的实际输出维度一致, 且与目标库 vector(N) 列宽度一致）──
# ⚠️ 不同 provider/模型的原生维度不同（OpenAI text-embedding-3-small=1536,
#    Ollama mxbai-embed-large=1024, nomic-embed-text=768, bge-m3=1024 ...）。
#    EMBED_DIM 设错会在写入时被 core/embedding.py 的维度校验立即拦下并报错
#    （Ollama 对超出模型原生维度的 `dimensions` 请求会静默忽略、返回原生长度，
#    不会报错也不会自动补齐/截断 —— 必须用 EMBED_DIM 显式声明真实维度）。
# EMBED_DIM=1536

# ② 火山引擎 ARK（豆包）— 日常对话 LLM（不用于 embedding）
#    注册获取密钥: https://console.volcengine.com/ark
ARK_API_KEY=

# ③ DeepSeek — 蒸馏/审计等深度任务（v6.5+ 双底座推荐配置）
#    注册获取密钥: https://platform.deepseek.com
DEEPSEEK_API_KEY=
# DEEPSEEK_BASE_URL=https://api.deepseek.com/v1    # 可选，默认官方端点
# DEEPSEEK_PRO=deepseek-v4-pro                     # 可选，深度推理模型
# DEEPSEEK_FLASH=deepseek-v4-flash                 # 可选，快速模型

# ④ 对话也走 OpenAI 兼容端点时（可选，设置 MODEL_BACKEND=openai 后启用）
# MODEL_BACKEND=ark                                  # ark(默认) | openai — 仅影响对话层，不影响 embedding
# OPENAI_CHAT_MINI=gpt-4o-mini
# OPENAI_CHAT_LITE=gpt-4o
# OPENAI_CHAT_CODE=gpt-4o

# ─────────────────────────────────────────
# 2. PostgreSQL（必填）
# ─────────────────────────────────────────
PGUSER=mnemosyne
PGPASSWORD=your-strong-password
PGDATABASE=mnemosyne
PGHOST=127.0.0.1
PGPORT=5432
# PGSCHEMA=public                 # 默认 public；与同一数据库中的其它应用共存时
                                   # 改为专属 schema (如 mnemosyne)，须与部署
                                   # docs/schema.sql 时实际使用的 schema 一致

# ─────────────────────────────────────────
# 3. 服务监听
# ─────────────────────────────────────────
MNEMOSYNE_HOST=127.0.0.1
# ⚠️ 端口暂由 main.py 硬编码为 8010（v7.6.1），MNEMOSYNE_PORT 尚未生效，下版本修复
MNEMOSYNE_PORT=8010

# ─────────────────────────────────────────
# 4. 可选调优（默认值即可，进阶才改）
# ─────────────────────────────────────────
# TMT_LLM_TIER=lite            # 蒸馏用模型梯队: mini/lite/pro
# TMT_MAX_RETRIES=3            # LLM 调用最大重试
