# Minnas environment config template
# Copy to .env and fill in your keys: cp .env.template .env
# Full installation guide: INSTALL.md

# ─────────────────────────────────────────
# 1. Model backends
# ─────────────────────────────────────────

# ① Embedding — its OWN service, independent of the chat model (which uses the
#    backend selected by MODEL_BACKEND, default "ark"). Set the dedicated EMBED_*
#    vars to point embedding at any OpenAI-compatible service. Both fall back to
#    the OPENAI_* vars below (used by the "openai" backend when MODEL_BACKEND=openai).
#    Sign up for an OpenAI key: https://platform.openai.com
OPENAI_API_KEY=

# ── Dedicated embedding service (set these to decouple embedding from the model) ──
# EMBED_BASE_URL=http://localhost:8000/v1        # base of the embedding service; "/embeddings" is appended
# EMBED_MODEL=text-embedding-3-small             # default 1536-dim, must match vector(N) in docs/schema.sql
# EMBED_DIM=1536                                 # must equal the model's native output dimension
#
#    Ollama example (local or dev server; base URL needs /v1, API key can be blank/any value):
# EMBED_BASE_URL=http://localhost:11434/v1
# EMBED_MODEL=mxbai-embed-large                  # native 1024-dim (run `ollama pull mxbai-embed-large` first)
# EMBED_DIM=1024
#
# ── Fallback vars (only used if the dedicated EMBED_* above are unset) ──
# OPENAI_BASE_URL=https://api.openai.com/v1      # local: http://localhost:8000/v1
# OPENAI_EMBED_MODEL=text-embedding-3-small

# ── Embedding dimension (must match the actual output dimension of the chosen embedding model, and the target table's vector(N) column width) ──
# ⚠️ Native dimensions differ by provider/model (OpenAI text-embedding-3-small=1536,
#    Ollama mxbai-embed-large=1024, nomic-embed-text=768, bge-m3=1024, ...).
#    A wrong EMBED_DIM is caught immediately on write by core/embedding.py's dimension
#    check and raises an error (Ollama silently ignores a `dimensions` request that
#    exceeds the model's native dimension and returns the native length instead — it
#    neither errors nor auto-pads/truncates — so EMBED_DIM must explicitly declare the
#    real dimension).
# EMBED_DIM=1536

# ② Volcengine ARK (Doubao) — day-to-day chat LLM (not used for embedding)
#    Sign up for a key: https://console.volcengine.com/ark
ARK_API_KEY=

# ③ DeepSeek — distillation/audit and other deep-reasoning tasks (recommended dual-backend config for v6.5+)
#    Sign up for a key: https://platform.deepseek.com
DEEPSEEK_API_KEY=
# DEEPSEEK_BASE_URL=https://api.deepseek.com/v1    # optional, defaults to the official endpoint
# DEEPSEEK_PRO=deepseek-v4-pro                     # optional, deep-reasoning model
# DEEPSEEK_FLASH=deepseek-v4-flash                 # optional, fast model

# ④ If chat should also go through an OpenAI-compatible endpoint (optional, enabled by setting MODEL_BACKEND=openai)
# MODEL_BACKEND=ark                                  # ark (default) | openai — only affects the chat layer, not embedding
# OPENAI_CHAT_MINI=gpt-4o-mini
# OPENAI_CHAT_LITE=gpt-4o
# OPENAI_CHAT_CODE=gpt-4o

# ⑤ Decision model (Jev-style) — its OWN service, like ① embedding.
#    Ollama's dedicated decision route: POST <base>/systemone. Note that
#    `systemone` is a ROUTE, not a model — the request body's `model` field
#    takes nimble | tev1 | tev1:0.8b (must be a model actually pulled on that
#    instance; Ollama's `/v1` base needs the /v1 suffix, as ① embedding).
# DECISION_BASE_URL=http://localhost:11434/v1        # base of the decision service; "/systemone" is appended
# DECISION_MODEL=tev1:0.8b                           # nimble | tev1 | tev1:0.8b
# DECISION_API_KEY=                                  # optional — falls back to OPENAI_API_KEY (Ollama ignores it)

# ─────────────────────────────────────────
# 2. PostgreSQL (required)
# ─────────────────────────────────────────
PGUSER=mnemosyne
PGPASSWORD=your-strong-password
PGDATABASE=mnemosyne
PGHOST=127.0.0.1
PGPORT=5432
# PGSCHEMA=public                 # defaults to public; if coexisting with other apps in
                                   # the same database, change to a dedicated schema (e.g.
                                   # mnemosyne) — must match the schema actually used when
                                   # deploying docs/schema.sql

# ─────────────────────────────────────────
# 3. Service listener
# ─────────────────────────────────────────
MNEMOSYNE_HOST=127.0.0.1
MNEMOSYNE_PORT=8010

# ─────────────────────────────────────────
# 4. Optional tuning (defaults are fine; only change for advanced use)
# ─────────────────────────────────────────
# TMT_LLM_TIER=lite            # model tier used for distillation: mini/lite/pro
# TMT_MAX_RETRIES=3            # max retries for LLM calls
